# =============================================================================
# GraphWeather5p625 — commit code + configs only. Exclude large/generated/
# machine-specific artifacts (checkpoints, analysis, data, run logs).
# =============================================================================

# --- Trained models, checkpoints, and all per-experiment analysis outputs ----
# (11 GB; produced by training / evaluation / diagnostics — regenerate locally)
# ANCHORED to the repo root: a bare `experiments/` also matched configs/experiments/
# and docs/experiments/ (source dirs that MUST be tracked). `/experiments` covers
# both the old dir and the P4 compat symlink -> archive/experiments/.
/experiments

# --- Frozen legacy tree + release bundles (P4): moved under archive/, ignored.
# archive/scripts/ and archive/configs/ hold small retired CODE and stay TRACKED.
/archive/experiments/
/archive/zips/

# --- Fresh output roots for NEW runs (keep the empty dirs, exclude contents) --
# New experiments land in runs/, comparison figures in comparisons/.
runs/*
!runs/.gitkeep
comparisons/*
!comparisons/.gitkeep

# --- Experiment tracking / run logs ------------------------------------------
wandb/
runtime_diagnosis/
# default local output dir for run_diagnostics.py (top-level only; keep src/diagnostics/)
/diagnostics/
logs/
# captured stdout/stderr logs (e.g. dashboard/server.out, *.out run logs)
*.out

# --- Data & normalization stats (large; provide/regenerate locally) ----------
# ERA5 data lives outside the repo; delta stats + climatology are rebuilt via
# scripts/build_climatology.py and the delta-stats path in the config.
# EXCEPTION: data/baselines/ is TRACKED (small KAI reference CSVs consumed by the
# plotter + dashboard). Uses data/* (not data/) so the baselines dir can be
# re-included — git cannot re-include under a fully-excluded parent dir.
data/*
!data/baselines/
!data/baselines/*.csv

# --- Graphs (auto-built at runtime via auto_build_graph: true) ----------------
graphs/

# --- Release/experiment bundles (hundreds of MB each; never commit) ----------
*.zip
*.tar
*.tar.gz

# --- Generated test baseline (machine-specific paths; regenerates on 1st run) -
tests/config_resolved_goldens/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.ipynb_checkpoints/
.pytest_cache/

# --- Environments ------------------------------------------------------------
.venv/
venv/
env/

# --- OS / editor -------------------------------------------------------------
.DS_Store
*.swp
*~
dashboard/data/

# --- Large binaries: generated decks + third-party papers --------------------
# The .pptx decks are OUTPUTS of scripts/create_architecture_ppt.py and
# scripts/annotate_architecture_results_ppt.py (both tracked), so they are
# regenerable; ~76 MB of them would otherwise be permanent history. The archive
# PDF is a third-party paper we do not own.
*.pptx
/archive/*.pdf

# --- Claude Code per-machine settings ---------------------------------------
# .claude/skills/ IS tracked (shared project tooling); this file is local-only.
.claude/settings.local.json

# --- Untracked by request: local-only reference material ---------------------
# Both stay in the working tree; they are simply not published. NOTE: this
# reverses the P5 decision that archive/scripts/ + archive/configs/ (small
# retired code) stay tracked. dashboard/docs/ is unaffected (own path).
/archive/
/docs/
